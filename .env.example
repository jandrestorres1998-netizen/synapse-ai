# ─────────────────────────────────────────────────────────────────────────────
# SynapseAI Gateway — configuración
# Copia este archivo a .env y ajusta los valores. .env está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
# 127.0.0.1 evita exponer el gateway a la red local sin querer.
HOST=127.0.0.1
LOG_LEVEL=info

# ── Autenticación ────────────────────────────────────────────────────────────
# Obligatorio en producción. Genera cada clave con:  openssl rand -hex 32
# Lista separada por comas para poder rotar sin downtime.
#
# Cada clave puede llevar un ámbito como prefijo:
#   <secreto>              → ámbito completo (tu clave de operador)
#   inference:<secreto>    → solo /v1/* y /api/gateway/* (clave de aplicación)
#   report:<secreto>       → solo /api/extension/event (extensión de navegador)
#
# Da a la extensión una clave "report:". Sin ámbitos, la clave que vive en el
# navegador de cada empleado también abre el vault de credenciales y el
# registro completo de auditoría.
SYNAPSE_API_KEYS=

# Solo para uso local de una sola persona. Prohibido con NODE_ENV=production.
SYNAPSE_DISABLE_AUTH=false

# Orígenes permitidos por CORS (lista separada por comas). Nunca "*".
SYNAPSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Número de proxies de confianza delante del gateway. 0 = ignorar X-Forwarded-For.
SYNAPSE_TRUST_PROXY_HOPS=0

# ── Cifrado en reposo ────────────────────────────────────────────────────────
# Clave maestra del vault (mín. 32 caracteres). Sin ella, el vault cae al modo
# "machine", que NO protege frente a un atacante con acceso local al disco.
SYNAPSE_VAULT_KEY=

# Autentica la cadena de auditoría. Guárdala fuera de la máquina auditada.
SYNAPSE_AUDIT_HMAC_KEY=

# ── Proveedores de modelos ───────────────────────────────────────────────────
# Pueden definirse aquí o guardarse cifradas en el vault desde el panel.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OLLAMA_BASE_URL=http://127.0.0.1:11434
SYNAPSE_PROVIDER_TIMEOUT_MS=120000

# Proveedor mock: devuelve texto sintético, NO inferencia real.
# Solo para desarrollo y CI. El arranque falla si se activa en producción.
SYNAPSE_ALLOW_MOCK_PROVIDER=true

# ── Caché ────────────────────────────────────────────────────────────────────
# Exacta: segura, solo sirve respuestas a prompts idénticos.
SYNAPSE_CACHE_EXACT=true
# Semántica: sirve la respuesta de un prompt DISTINTO pero parecido.
# Es un intercambio de exactitud por coste. Desactivada por defecto.
SYNAPSE_CACHE_SEMANTIC=false
SYNAPSE_CACHE_SEMANTIC_THRESHOLD=0.97
SYNAPSE_CACHE_TTL_MS=86400000
SYNAPSE_CACHE_MAX_ENTRIES=1000

# ── DLP ──────────────────────────────────────────────────────────────────────
# redact = enmascara y continúa | block = rechaza la petición
SYNAPSE_DLP_ON_DETECTION=redact
# Guardar el texto sensible en los logs de auditoría. Desaconsejado.
SYNAPSE_DLP_STORE_PLAINTEXT=false

# ── Límite de peticiones ─────────────────────────────────────────────────────
SYNAPSE_RATE_WINDOW_MS=60000
SYNAPSE_RATE_MAX=60
SYNAPSE_RATE_MAX_CLIENTS=10000

# ── Facturación ──────────────────────────────────────────────────────────────
# Sin este valor el endpoint /api/webhooks/stripe queda deshabilitado.
STRIPE_WEBHOOK_SECRET=
