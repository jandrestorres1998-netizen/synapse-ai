# Dependencias
node_modules/
client/frontend/node_modules/

# Secretos — nunca deben entrar al control de versiones
.env
.env.*
!.env.example
data/vault.enc
data/license.key
data/keys/
*.pem
*.key

# Datos de ejecución
data/memories.json
data/audit-ledger.jsonl
data/*.corrupt-*
data/*.tmp
data/*.bak

# Prototipo React con su propio historial git. Añadirlo aquí lo convertiría en
# un submódulo que apunta a ninguna parte. Ver client/README.md: no está
# conectado al servidor y su destino es una decisión pendiente.
client/frontend/

# Artefactos de build
dist/
client/frontend/dist/
coverage/
*.log

# Los renders se regeneran; el bucle publicado vive en public/media/.
videos/*/renders/

# Cache de herramientas del agente: se reinstalan solas y son casi 1.900
# ficheros que no son fuente de este proyecto.
.claude/skills/
.agents/
.agent/
.vscode/
skills-lock.json

# Estado de ejecucion: lo escribe el servidor al arrancar, y lleva dentro
# identificadores de inquilino y gasto real. No es fuente del proyecto.
data/budget.json

# Documentos de trabajo interno: estrategia comercial, estudio de mercado,
# backlog, planes y encargos a otros modelos. Se quedan en disco; no viajan al
# repositorio ni al paquete que se descarga un cliente.
docs/BRIEF_REDISENO_WEB.md
docs/DEEP_RESEARCH_AND_PROS_CONS.md
docs/ENCARGO_GEMINI.md
docs/GO_TO_MARKET_STRATEGY.md
docs/HANDOVER_CLAUDE.md
docs/MARKET_RESEARCH.md
docs/PLAN_MODULARIZACION.md
docs/PLAN_VIDEO_FLUJO.md
docs/TASKS_AND_BACKLOG.md
